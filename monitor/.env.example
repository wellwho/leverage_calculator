# Copy to monitor/.env and fill in. Never commit the real .env.
# The monitor reads public market data only: no exchange keys, no account access.

# --- Telegram (required for alerts; without it messages print to the log) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Heartbeat: a healthchecks.io ping URL. Optional but recommended: it's
# what tells you the NAS or the monitor itself has gone quiet. ---
HEALTHCHECK_URL=

# --- What to watch ---
# Coins that get their own alerts (full readout):
WATCHLIST=BTC
# Majors combined into the market-wide score (no individual alerts):
BASKET=BTC,ETH,SOL,XRP,DOGE,BNB,ADA,LINK,AVAX,SUI
POLL_SECONDS=300

# --- Flush risk thresholds (composite score, 0..1), for coins and the market ---
RISK_ELEVATED=0.70
RISK_HIGH=0.80
RISK_CLEAR=0.55
MIN_COVERAGE=0.5
REPEAT_HOURS=6

# --- Market breadth: share of basket coins at/above RISK_ELEVATED ---
# At or above BREADTH_ELEVATED the market alert is at least ELEVATED;
# an active market alert is held until breadth falls below BREADTH_HOLD.
BREADTH_ELEVATED=0.7
BREADTH_HOLD=0.5
# Share of the basket that must be readable for a market score at all.
MIN_BASKET_SHARE=0.6

# --- "Flush under way" detection for watchlist coins ---
FLUSH_HOURS=4
FLUSH_OI_DROP=0.08
FLUSH_PRICE_DROP=0.04
FLUSH_COOLDOWN_HOURS=12

# Optional weight overrides, e.g. WEIGHTS=premium=0.3,crowding=0
# Keys: oiLevel, longBuildup, funding, premium, crowding, takerSelling, extension
WEIGHTS=
