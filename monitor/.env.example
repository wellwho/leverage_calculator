# Copy to monitor/.env and fill in. Never commit the real .env.

# --- Telegram (required for alerts; without it messages print to the log) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Exchange keys: READ-ONLY keys only (see README). Optional: without
# them the monitor still watches WATCHLIST, it just can't see positions. ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=

# --- Heartbeat: a healthchecks.io ping URL. Optional but recommended: it's
# what tells you the NAS or the monitor itself has gone quiet. ---
HEALTHCHECK_URL=

# --- What to watch (open positions are added automatically) ---
WATCHLIST=CRV
POLL_SECONDS=300

# --- Flush risk thresholds (composite score, 0..1) ---
RISK_ELEVATED=0.70
RISK_HIGH=0.80
RISK_CLEAR=0.55
MIN_COVERAGE=0.5
REPEAT_HOURS=6

# --- Liquidation distance alerts (fraction of price) ---
LIQ_WARN=0.15
LIQ_DANGER=0.08

# --- "Flush under way" detection: OI and price both down this much within FLUSH_HOURS ---
FLUSH_HOURS=4
FLUSH_OI_DROP=0.08
FLUSH_PRICE_DROP=0.04
FLUSH_COOLDOWN_HOURS=12

# Spot balances worth less than this (USD) are ignored unless watchlisted.
MIN_SPOT_USD=10

# Optional weight overrides, e.g. WEIGHTS=premium=0.3,crowding=0
# Keys: oiLevel, longBuildup, funding, premium, crowding, takerSelling, extension
WEIGHTS=
